+def _semantic_report_from_reference(record):
+    source = record["source_semantics"]
+    station_by_index = {
+        station["source_wall_face_index_zero_based"]: station
+        for station in record["stations"]
+    }
+    rows = []
+    for face_index in range(source["canonical_step_face_count"]):
+        station = station_by_index.get(face_index)
+        if station is None:
+            region_name, region_code = ("natural_rim", 3) if face_index == 2 else ("base", 4)
+            rows.append(
+                {
+                    "face_index_zero_based": face_index,
+                    "status": "CLASSIFIED",
+                    "region_code": region_code,
+                    "region_name": region_name,
+                    "classifier_version": source["classifier"],
+                    "canonical_step_sha256": source["canonical_step_sha256"],
+                }
+            )
+            continue
+        evidence = station["source_classification_evidence"]
+        rows.append(
+            {
+                "face_index_zero_based": face_index,
+                "status": "CLASSIFIED",
+                "region_code": 1 if station["wall_role"] == "outer" else 2,
+                "region_name": evidence["region_name"],
+                "classifier_version": evidence["classifier_version"],
+                "canonical_step_sha256": evidence["canonical_step_sha256"],
+                "classification_basis": evidence["classification_basis"],
+                "classification_evidence": copy.deepcopy(evidence["classification_evidence"]),
+                "interior_sample": copy.deepcopy(evidence["interior_sample"]),
+            }
+        )
+    return {
+        "schema": source["schema"],
+        "status": source["status"],
+        "classifier": source["classifier"],
+        "canonical_step_sha256": source["canonical_step_sha256"],
+        "canonical_step_face_count": source["canonical_step_face_count"],
+        "faces": rows,
+    }
+
